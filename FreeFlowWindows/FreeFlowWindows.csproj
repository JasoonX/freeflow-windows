<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\AppLogo.ico</ApplicationIcon>
    <AssemblyName>FreeFlowWindows</AssemblyName>
    <Product>FreeFlow for Windows</Product>
    <Description>Push-to-talk dictation for Windows using Groq.</Description>
    <Company>FreeFlow</Company>
    <Authors>FreeFlow contributors</Authors>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/mrinalwadhwa/freeflow</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\AppLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\AppLogo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
